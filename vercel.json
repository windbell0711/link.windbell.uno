{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/static/homepage.html"
    }
  ],
  "redirects": [
    {
      "source": "/permanent/:code",
      "destination": "/static/redirect.html?code=:code"
    },
    {
      "source": "/oss/:key",
      "destination": "/static/storage.html?key=:key"
    }
  ]
}